# Copy this file to .env and replace every placeholder before starting.
# Pin RUSTFS_IMAGE to a reviewed release tag or digest for production.
RUSTFS_IMAGE=rustfs/rustfs:latest

# Generate unique, high-entropy credentials. Never reuse these examples.
RUSTFS_ACCESS_KEY=REPLACE_WITH_A_UNIQUE_ACCESS_KEY
RUSTFS_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local-only bindings; expose through a TLS reverse proxy.
S3_BIND_PORT=9000
CONSOLE_BIND_PORT=9001

# Change this to the exact browser origin used to access the console.
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=http://localhost:9001
RUSTFS_OBS_LOGGER_LEVEL=info
